              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.time.LocalDate
import java.time.format.DateTimeFormatter
import org.apache.jmeter.protocol.http.util.HTTPArgument

boolean enableRoundTrip = true  // у тебя в .cgifields есть roundtrip, значит включаем

def cities = [&quot;Denver&quot;,&quot;Frankfurt&quot;,&quot;London&quot;,&quot;Los Angeles&quot;,&quot;Paris&quot;,&quot;Portland&quot;,&quot;San Francisco&quot;,&quot;Seattle&quot;,&quot;Sydney&quot;,&quot;Zurich&quot;]
def seatPrefList = [&quot;None&quot;,&quot;Aisle&quot;,&quot;Window&quot;]
def seatTypeList = [&quot;Coach&quot;,&quot;Business&quot;,&quot;First&quot;]
def rnd = new Random()

def depart = cities[rnd.nextInt(cities.size())]
def arrive
do { arrive = cities[rnd.nextInt(cities.size())] } while (arrive == depart)

def fmt = DateTimeFormatter.ofPattern(&quot;MM/dd/yyyy&quot;)
def depDate = LocalDate.now().plusDays(1 + rnd.nextInt(30))
def retDate = depDate.plusDays(1 + rnd.nextInt(14))

def departDate = depDate.format(fmt)
def returnDate = retDate.format(fmt)

def numPassengers = &quot;1&quot;
def seatPref = seatPrefList[rnd.nextInt(seatPrefList.size())]
def seatType = seatTypeList[rnd.nextInt(seatTypeList.size())]

def args = sampler.getArguments()
args.clear()

def addHttp = { String name, String value -&gt;
    def a = new HTTPArgument(name, value)
    a.setUseEquals(true)
    a.setAlwaysEncoded(false)
    args.addArgument(a)
}

addHttp(&quot;advanceDiscount&quot;, &quot;0&quot;)
addHttp(&quot;depart&quot;, depart)
addHttp(&quot;departDate&quot;, departDate)
addHttp(&quot;arrive&quot;, arrive)
addHttp(&quot;returnDate&quot;, returnDate)
addHttp(&quot;numPassengers&quot;, numPassengers)
addHttp(&quot;seatPref&quot;, seatPref)
addHttp(&quot;seatType&quot;, seatType)

// кнопка поиска
addHttp(&quot;findFlights.x&quot;, &quot;58&quot;)
addHttp(&quot;findFlights.y&quot;, &quot;8&quot;)

// roundtrip (раз у тебя он есть в исходном запросе)
if (enableRoundTrip) addHttp(&quot;roundtrip&quot;, &quot;on&quot;)

// .cgifields (повторяющийся)
addHttp(&quot;.cgifields&quot;, &quot;roundtrip&quot;)
addHttp(&quot;.cgifields&quot;, &quot;seatType&quot;)
addHttp(&quot;.cgifields&quot;, &quot;seatPref&quot;)

// сохраняем в vars
vars.put(&quot;depart&quot;, depart)
vars.put(&quot;arrive&quot;, arrive)
vars.put(&quot;departDate&quot;, departDate)
vars.put(&quot;returnDate&quot;, returnDate)
vars.put(&quot;seatPref&quot;, seatPref)
vars.put(&quot;seatType&quot;, seatType)
