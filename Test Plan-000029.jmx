              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import org.apache.jmeter.protocol.http.util.HTTPArgument

int n = (vars.get(&apos;outboundFlight_matchNr&apos;) ?: &apos;0&apos;) as int
if (n &lt;= 0) {
    throw new IllegalStateException(&quot;No outboundFlight found. outboundFlight_matchNr=0&quot;)
}

int idx = 1 + new Random().nextInt(n)
String chosen = vars.get(&quot;outboundFlight_${idx}&quot;)
vars.put(&quot;chosen_outboundFlight&quot;, chosen)

def args = sampler.getArguments()
args.clear()

def addHttp = { String name, String value -&gt;
    def a = new HTTPArgument(name, value)
    a.setUseEquals(true)
    a.setAlwaysEncoded(false)
    args.addArgument(a)
}

addHttp(&quot;outboundFlight&quot;, chosen)
addHttp(&quot;numPassengers&quot;, vars.get(&quot;numPassengers&quot;) ?: &quot;1&quot;)
addHttp(&quot;advanceDiscount&quot;, &quot;0&quot;)
addHttp(&quot;seatType&quot;, vars.get(&quot;seatType&quot;) ?: &quot;Coach&quot;)
addHttp(&quot;seatPref&quot;, vars.get(&quot;seatPref&quot;) ?: &quot;None&quot;)
addHttp(&quot;reserveFlights.x&quot;, &quot;44&quot;)
addHttp(&quot;reserveFlights.y&quot;, &quot;10&quot;)
</stringProp>
            </JSR223PreProcessor>
