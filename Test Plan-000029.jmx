              <stringProp name="script">import org.apache.jmeter.protocol.http.util.HTTPArgument

def args = sampler.getArguments()
args.clear()

def addHttp = { String name, String value -&gt;
    def a = new HTTPArgument(name, value)
    a.setUseEquals(true)
    a.setAlwaysEncoded(false)
    args.addArgument(a)
}

addHttp(&quot;firstName&quot;, vars.get(&quot;username&quot;) ?: &quot;User&quot;)
addHttp(&quot;lastName&quot;,  vars.get(&quot;lastName&quot;) ?: &quot;Test&quot;)
addHttp(&quot;address1&quot;,  vars.get(&quot;address1&quot;) ?: &quot;Street 1&quot;)
addHttp(&quot;address2&quot;,  vars.get(&quot;address2&quot;) ?: &quot;Apt 1&quot;)
addHttp(&quot;pass1&quot;,     vars.get(&quot;lastName&quot;) ?: &quot;Test&quot;)

